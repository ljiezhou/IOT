<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.NewFramework" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- 低饱和度科技风格主题 -->
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Theme.NewFramework" parent="Base.Theme.NewFramework" />


    <!-- 按钮样式 - 柔和科技风格 -->
    <style name="HostActionButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">@drawable/main_confirm_bg</item>
        <item name="android:elevation">2dp</item>
    </style>


    <!-- 按钮样式 - 柔和科技风格 -->
    <style name="HostActionButton2">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_margin">8dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:background">@drawable/main_confirm_bg</item>
        <item name="android:elevation">2dp</item>
    </style>

</resources>