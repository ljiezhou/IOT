<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 选中状态 -->
    <item android:color="@color/color_text_title_dark" android:state_selected="true" />
    <!-- 按下/按压状态 -->
    <item android:color="@color/color_text_title_dark" android:state_pressed="true" />
    <!-- 禁用状态 -->
    <item android:color="@color/color_text_title_light" android:state_enabled="false" />
    <!-- 默认颜色 -->
    <item android:color="@color/color_text_title_light" />
</selector>